# Kopiér til .env og udfyld. .env må aldrig committes.
# Produktionens hemmeligheder må aldrig kopieres ind her (specifikation 14.2).

SUKKER_ENV=development
SUKKER_SECRET_KEY=skift-mig-til-en-lang-tilfaeldig-streng
SUKKER_BASE_URL=http://localhost:5000

# Applikationen kører som sukker_app. Migrationer kører som sukker_migrator (specifikation 14.4).
SUKKER_DATABASE_URL=postgresql+psycopg://sukker_app:APP_PASSWORD@localhost:5432/sukker_dev
SUKKER_MIGRATOR_DATABASE_URL=postgresql+psycopg://sukker_migrator:MIGRATOR_PASSWORD@localhost:5432/sukker_dev
# Testdatabasen bruges af pytest og nulstilles ved hver testkørsel.
SUKKER_TEST_DATABASE_URL=postgresql+psycopg://sukker_migrator:MIGRATOR_PASSWORD@localhost:5432/sukker_test

# API-nøgle til Datafordeleren. Bruges kun af `flask sukker build-geo` til at hente kommuner og postnumre (DAGI).
SUKKER_DATAFORDELER_APIKEY=

# console: mails skrives til loggen og til instance/outbox. smtp: rigtig afsendelse.
SUKKER_MAIL_BACKEND=console
SUKKER_MAIL_FROM=Sukker.nu <noreply@sukker.nu>
SUKKER_SMTP_HOST=
SUKKER_SMTP_PORT=587
SUKKER_SMTP_USERNAME=
SUKKER_SMTP_PASSWORD=

# Offentlige sider: kontakt og den dataansvarlige virksomhed (vises på /om og /privatlivspolitik).
SUKKER_CONTACT_EMAIL=kontakt@sukker.nu
SUKKER_COMPANY_NAME=
SUKKER_COMPANY_CVR=
SUKKER_COMPANY_ADDRESS=
# Officiel lancering. Indtil da vises en pre-release-side med nedtælling. Tom = ingen pre-release.
SUKKER_LAUNCH_AT=2026-11-01T00:00:00+01:00
# Sæt til 1 på staging: alt får noindex, og robots.txt udelukker hele siden.
SUKKER_NOINDEX_ALL=0
